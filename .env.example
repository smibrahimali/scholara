# Backend / shared (root .env) — copy to .env and fill real values.
# Never commit .env or real secrets.

PORT=3000
NODE_ENV=development

# Supabase PostgreSQL (NestJS + TypeORM)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase project (NestJS Storage — service role, server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Demo JWT auth (required)
JWT_SECRET=change-me-to-a-long-random-string

# Groq AI (NestJS only — never expose to Vite)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# CORS for local Vite frontend
WEB_ORIGIN=http://localhost:5173

# Frontend (optional frontend/.env) — public only:
# VITE_API_URL=http://localhost:3000/api
